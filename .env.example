# Copy to .env.local for development. Never commit real secrets.

APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/health
# 32+ random characters, e.g.  openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# Brand (working name until the real one is chosen)
NEXT_PUBLIC_BRAND_NAME=Seba
NEXT_PUBLIC_BRAND_NAME_BN=সেবা
NEXT_PUBLIC_SUPPORT_PHONE=

# --- SMS ---------------------------------------------------------------
# dev   = messages are written to the server log and the notifications table
#         with status 'dev_logged'. Nothing is sent.
# msg91 = real SMS (needs DLT-registered sender ID and templates)
SMS_PROVIDER=dev
MSG91_AUTH_KEY=
MSG91_SENDER_ID=

# --- Payments ----------------------------------------------------------
# dev      = simulated checkout, clearly marked "TEST PAYMENT — no money moved"
# razorpay = real gateway with server-side signature verification
PAYMENT_PROVIDER=dev
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Private file storage (prescriptions, licences) ---------------------
# dev-local = files on this machine under STORAGE_LOCAL_DIR, served only via
#             short-lived signed links
# s3        = S3-compatible bucket (keep it in an India region)
STORAGE_DRIVER=dev-local
STORAGE_LOCAL_DIR=.data/private-files
S3_BUCKET=
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Production refuses to start with any dev adapter unless this is "true"
# (only for a staging site that must never take real users).
ALLOW_DEV_ADAPTERS_IN_PRODUCTION=false

# Background jobs over HTTP (optional; 32+ random characters). Leave empty to disable /api/jobs/*.
CRON_SECRET=
